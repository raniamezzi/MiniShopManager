<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Soft ice-blue rounded squircle background -->
    <path android:pathData="M34,4 L62,4 A30,30 0 0 1 92,34 L92,62 A30,30 0 0 1 62,92 L34,92 A30,30 0 0 1 4,62 L4,34 A30,30 0 0 1 34,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="84"
                android:endY="88"
                android:startX="12"
                android:startY="8"
                android:type="linear">
                <item
                    android:color="#F0F6FF"
                    android:offset="0.0" />
                <item
                    android:color="#DBEAFE"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Back handle loop -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,34 C41,21 60,21 60,34"
        android:strokeColor="#93C5FD"
        android:strokeLineCap="round"
        android:strokeWidth="4" />

    <!-- Front handle loop -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,35 C36,21 55,21 55,35"
        android:strokeColor="#2563EB"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />

    <!-- Classic tapered shopping bag body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,33 L68,33 L73,70 A7,7 0 0 1 66,77 L30,77 A7,7 0 0 1 23,70 Z"
        android:strokeColor="#BFDBFE"
        android:strokeWidth="1.5" />

    <!-- Subtle bag side fold shadow -->
    <path
        android:fillColor="#EFF6FF"
        android:pathData="M62,33 L68,33 L73,70 A7,7 0 0 1 66,77 L61,77 Z" />

    <!-- Handle attachment dots -->
    <path
        android:fillColor="#2563EB"
        android:pathData="M36,39 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
    <path
        android:fillColor="#2563EB"
        android:pathData="M55,39 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />

    <!-- Blended blue-to-navy M centered on the shopping bag -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34,63 L41,49 L47,60 L53,49 L60,63"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="56"
                android:endY="58"
                android:startX="34"
                android:startY="54"
                android:type="linear">
                <item
                    android:color="#2563EB"
                    android:offset="0.0" />
                <item
                    android:color="#1D4ED8"
                    android:offset="0.35" />
                <item
                    android:color="#06163A"
                    android:offset="0.58" />
                <item
                    android:color="#030B24"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
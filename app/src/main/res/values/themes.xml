<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">


    <style name="Theme.MiniShopManager" parent="Theme.Material3.Light.NoActionBar">

        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorTertiary">@color/success</item>
        <item name="colorOnTertiary">@color/on_success</item>

        <!-- Fond et surfaces -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/separator</item>

        <!-- Barres système -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Texte par défaut -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Style par défaut des boutons (coins arrondis) -->
        <item name="materialButtonStyle">@style/Widget.MiniShop.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MiniShop.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.MiniShop.Button.Text</item>
    </style>

    <!-- Forme arrondie des boutons : 14dp (entre 12dp et 16dp) -->
    <style name="ShapeAppearance.MiniShop.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Bouton plein (accent bleu) -->
    <style name="Widget.MiniShop.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Bouton contour -->
    <style name="Widget.MiniShop.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Button</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Bouton texte -->
    <style name="Widget.MiniShop.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>